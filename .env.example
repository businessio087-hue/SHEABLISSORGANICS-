# GoDaddy Node.js application settings
# Copy these names into cPanel > Setup Node.js App > Environment variables.
NODE_ENV=production
PORT=3000

# GoDaddy MySQL connection. Use the exact database/user/host values from cPanel.
# URL-encode special characters in the password.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# Yoco Production credentials. Never commit real values.
YOCO_SECRET_KEY=sk_live_replace_in_cpanel
YOCO_WEBHOOK_SECRET=replace_in_cpanel

# Gmail SMTP sender. Use a Gmail App Password, not the normal account password.
GMAIL_SMTP_USER=SHEABLISS8@gmail.com
GMAIL_SMTP_APP_PASSWORD=replace_in_cpanel

# Bob Go is not yet enabled in the application code. Add these when the Sandbox adapter is installed.
# BOBGO_API_KEY=replace_in_cpanel
# BOBGO_WEBHOOK_SECRET=replace_in_cpanel
# BOBGO_BASE_URL=https://api.sandbox.bobgo.co.za
